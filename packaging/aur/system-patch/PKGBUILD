# Maintainer: Peter Bozzo <peter.bozzo.swe@gmail.com>
#
# Tied to git tags. After pushing a new tag: bump pkgver, run `updpkgsums`,
# then `makepkg --printsrcinfo > .SRCINFO`.

pkgname=system-patch
pkgver=0.1.0
pkgrel=1
pkgdesc='TUI that shows every pending package update, why it was pushed, and whether to take it'
arch=('x86_64' 'aarch64')
url='https://github.com/Sousf/system-patch'
license=('MIT')
depends=('glibc')
makedepends=('go')
optdepends=(
  'pacman-contrib: repo updates via checkupdates'
  'paru: AUR updates'
  'arch-audit: Security Tracker CVEs'
  'github-cli: raises the GitHub API rate limit to 5000/hour'
  'claude-code: source analysis with the a key'
)
source=("$pkgname-$pkgver.tar.gz::$url/archive/v$pkgver.tar.gz")
sha256sums=('SKIP')  # replaced by updpkgsums once the tag exists

prepare() {
  cd "$pkgname-$pkgver"
  mkdir -p build
}

build() {
  cd "$pkgname-$pkgver"
  export CGO_CPPFLAGS="${CPPFLAGS}"
  export CGO_CFLAGS="${CFLAGS}"
  export CGO_CXXFLAGS="${CXXFLAGS}"
  export CGO_LDFLAGS="${LDFLAGS}"
  export GOFLAGS='-buildmode=pie -trimpath -mod=readonly -modcacherw'
  go build -ldflags "-linkmode external -extldflags ${LDFLAGS} -X main.version=${pkgver}" \
    -o build/system-patch .
}

check() {
  cd "$pkgname-$pkgver"
  go test ./...
}

package() {
  cd "$pkgname-$pkgver"
  install -Dm755 build/system-patch "$pkgdir/usr/bin/system-patch"
  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  install -Dm644 README.md "$pkgdir/usr/share/doc/$pkgname/README.md"
}
